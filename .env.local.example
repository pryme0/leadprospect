# ══════════════════════════════════════════════════════════════════
#  SYNQ — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  Lines starting with # are comments and are ignored.
# ══════════════════════════════════════════════════════════════════

# ── App URL ───────────────────────────────────────────────────────
# Used for OAuth redirect callbacks. Change to your production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth secret ───────────────────────────────────────────────────
# Random string used to sign session tokens. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=replace-with-random-32-char-string


# ══════════════════════════════════════════════════════════════════
#  COMM HUB — Channel Integrations
# ══════════════════════════════════════════════════════════════════

# ── UNIPILE (primary social inbox API) ────────────────────────────
# Powers: Instagram DMs, X/Twitter DMs, LinkedIn DMs, Facebook messages,
#         Messenger, WhatsApp Business, Slack, Gmail, Outlook
#
# Sign up:  https://unipile.com
# Dashboard: https://dashboard.unipile.com
#
# 1. Create an account at unipile.com
# 2. In the dashboard, go to API Keys → Create API Key
# 3. Copy your DSN (e.g. https://api1.unipile.com:13465) from the dashboard
# 4. Add your domain to the allowed origins in Unipile settings
#
UNIPILE_API_KEY=your_unipile_api_key_here
UNIPILE_DSN=https://api1.unipile.com:13465


# ── TIKTOK (direct API — not covered by Unipile) ──────────────────
# Required for TikTok video comments and DMs.
#
# 1. Apply for access at: https://developers.tiktok.com
# 2. Create an app under your TikTok for Business account
# 3. Request the following scopes:
#      - comment.list (read video comments)
#      - dm.list (read DMs, if approved)
#      - research.adlib.basic (for brand monitoring)
# 4. Get approved (can take 1–2 weeks for DM access)
# 5. Copy the Client Key and Client Secret below
#
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret


# ── YOUTUBE (Google API) ───────────────────────────────────────────
# Required for YouTube comment monitoring.
#
# 1. Go to: https://console.cloud.google.com
# 2. Create a project → Enable "YouTube Data API v3"
# 3. Go to Credentials → Create OAuth 2.0 Client ID
# 4. Set redirect URI to: $NEXT_PUBLIC_APP_URL/api/auth/google/callback
# 5. Also used for Gmail if not using Unipile
#
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret


# ── THREADS (Meta API) ─────────────────────────────────────────────
# Required for Threads post and reply monitoring.
# Uses the same Meta Developer App as Facebook/Instagram.
# Threads API access requires approval from Meta.
#
# 1. Go to: https://developers.facebook.com
# 2. Create an app → Select "Business" type
# 3. Add products: Threads API
# 4. Submit for review (required before going live)
# 5. Set redirect URI to: $NEXT_PUBLIC_APP_URL/api/auth/meta/callback
#
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=any_random_string_you_choose


# ── SALESFORCE ─────────────────────────────────────────────────────
# Required for Salesforce CRM integration.
#
# 1. In Salesforce Setup → Apps → App Manager → New Connected App
# 2. Enable OAuth Settings
# 3. Set callback URL to: $NEXT_PUBLIC_APP_URL/api/auth/salesforce/callback
# 4. Select scopes: api, refresh_token, offline_access
# 5. Save and copy the Consumer Key (Client ID) and Consumer Secret
#
SALESFORCE_CLIENT_ID=your_salesforce_consumer_key
SALESFORCE_CLIENT_SECRET=your_salesforce_consumer_secret


# ── SHOPIFY ────────────────────────────────────────────────────────
# Required for Shopify order/customer data sync.
#
# 1. Go to your Shopify Partner Dashboard or your store Admin
# 2. Apps → Develop apps → Create an app
# 3. Set redirect URL to: $NEXT_PUBLIC_APP_URL/api/auth/shopify/callback
# 4. Request scopes: read_customers, read_orders, read_products
# 5. Copy the Client ID and Client Secret
#
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret


# ══════════════════════════════════════════════════════════════════
#  USER-PROVIDED AT CONNECT TIME (no server env needed)
#  These are entered by the user inside the Comm Hub connect modal.
# ══════════════════════════════════════════════════════════════════
#
#  Telegram   — user provides their own Bot Token (from @BotFather)
#  Discord    — user provides Bot Token + Guild/Server ID
#  HubSpot    — user provides their Private App Token
#  Zendesk    — user provides their subdomain + API Token
#  Freshdesk  — user provides their domain + API Key
#  IMAP Email — user provides email address + App Password
#
# No server-side env variables needed for these channels.

# Crawler signals Postgres — powers the lead dashboard (read-only). Get from the crawler service config.
DATABASE_URL=postgresql://user:password@host:25060/dbname?sslmode=require


# ══════════════════════════════════════════════════════════════════
#  LEAD INTELLIGENCE — website analysis & per-user lead generation
# ══════════════════════════════════════════════════════════════════

# ── ANTHROPIC (Claude) — fallback provider for AI analysis ────────
# Powers /api/leads/generate and other AI analysis features (website
# analysis, brand terms, mention classification) as an automatic fallback
# whenever OPENAI_API_KEY is unset OR the OpenAI call fails for any reason
# (rate limits, quota exhaustion, etc.) — see src/lib/llm/json.ts.
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional model override (defaults to claude-opus-5).
# ANALYSIS_MODEL=claude-opus-5

# ── THELIXCRAWLER control API — optional ──────────────────────────
# Base URL of the running thelixcrawler Express API (e.g. http://localhost:3000
# or the DigitalOcean droplet). When set, /api/leads/generate provisions a
# per-user SBU + keywords and triggers crawls. When unset, keywords are staged
# and analysis is saved, but no crawl is started.
CRAWLER_API_URL=http://localhost:3000

# ── PAYSTACK — required to persist subscriptions server-side ──────
# Used by /api/subscription/verify to confirm payment and record which modules
# (e.g. "leads") the user is entitled to.
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Public production domain (e.g. https://www.synq.com) — SEO canonical/OG/sitemap/robots.
NEXT_PUBLIC_SITE_URL=https://www.synq.com

# ── Pulse mention monitoring (live brand mentions) ────────────────────────────
# Free stack (default). Hacker News needs no key and works out of the box.
# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube Data API v3 key (free quota): https://console.cloud.google.com
YOUTUBE_API_KEY=
# Web + news (free tier): https://newsdata.io  (or set BING_SEARCH_KEY instead)
NEWSDATA_API_KEY=
BING_SEARCH_KEY=
# Paid aggregator fallback for X / Instagram / Facebook (widest coverage).
# MENTIONS_AGGREGATOR=social-searcher ; key from your provider.
MENTIONS_AGGREGATOR=social-searcher
MENTIONS_AGGREGATOR_API_KEY=

# ── Integrations OAuth (per-provider apps you create) ─────────────────────────
# Set each app's redirect/callback URI to:
#   ${NEXT_PUBLIC_SITE_URL}/api/integrations/<id>/callback
#   e.g. http://localhost:3000/api/integrations/salesforce/callback
SALESFORCE_CLIENT_SECRET=
# SALESFORCE_LOGIN_URL=https://test.salesforce.com   # sandboxes only
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=

# Directory for the app SQLite databases (app.db / comms.db / leads.db).
# In production set this to a writable, persistent path (e.g. a mounted volume
# at /data). Leave unset for local dev (defaults to the project root).
# DATA_DIR=/data
